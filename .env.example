# Copia este archivo como ".env" y completa los valores.
# Sin KOMMO_TOKEN la app arranca en modo demo, con leads de prueba en memoria.

# Subdominio de la cuenta: https://<subdominio>.kommo.com
KOMMO_SUBDOMAIN=m52discobar

# Long-lived token de la integración privada (Ajustes > Integraciones > Keys and scopes)
KOMMO_TOKEN=

# Nombres tal como aparecen en Kommo (no distingue mayúsculas ni tildes)
KOMMO_PIPELINE=Lista 52
STAGE_ARRIVED=Llegó
# Etapas desde las que se permite entrar, separadas por coma
STAGES_ALLOWED=Inscrito,Reconfirmó

# PIN que pide la web antes de dejar validar. Vacío = sin PIN.
APP_PIN=

PORT=3000
